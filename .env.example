# Copy to .env on the server and fill in. Never commit the real file.

# GitHub owner whose GHCR image is pulled.
GITHUB_OWNER=martinkopac19

# Existing Docker network that Caddy runs on — the default network of the
# martinkopac-stack compose project. Verify with: docker network ls
PROXY_NETWORK=martinkopac-stack_default

TZ=Europe/Prague

# --- Public site ---------------------------------------------------------------
PUBLIC_BASE_URL=https://studentskaprague.cz

# --- Email (Resend) ------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Signing secret of the webhook that reports bounces and complaints.
# Create the endpoint at https://resend.com/webhooks pointing to
# https://studentskaprague.cz/api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# Sender shown to recipients. The domain must be verified in Resend.
MAIL_FROM="Backyard Dejvice <noreply@studentskaprague.cz>"

# Where reservation inquiry notifications are delivered.
# Switch to contact@studentskaprague.cz once that mailbox exists.
NOTIFY_EMAIL=kopacmartin@email.cz

# --- Booking calendars ---------------------------------------------------------
# These URLs contain private tokens — treat them as secrets.
AIRBNB_ICAL_URL=
BOOKING_ICAL_URL=
